# Fill an ignored .env.production; never commit a populated environment file.
NODE_ENV=production
DATABASE_URL=
DIRECT_DATABASE_URL=
# Download the CA from this project's Supabase Database Settings.
# Set exactly one: inline PEM in Vercel, or a readable local certificate path.
DATABASE_CA_CERT=
DATABASE_CA_CERT_PATH=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
SECURITY_STATE_MODE=postgres
SECURITY_STATE_SECRET=
FRONTEND_ORIGINS=
AUTH_BOT_CHALLENGE_ENABLED=true
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAMES=
# Choose these against Supabase and Vercel capacity; no guessed production budget.
DB_POOL_MAX=
DB_POOL_MAX_PROCESSES=
DB_POOL_CONNECTION_BUDGET=
# Vercel owns the adjacent ingress; leave this blank.
TRUSTED_PROXY_CIDRS=
