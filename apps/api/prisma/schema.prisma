generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ShopRole {
  OWNER
  ADMIN
  MANAGER
  CASHIER
  KITCHEN
}

enum ProductStatus {
  AVAILABLE
  SOLD_OUT
  HIDDEN
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  isActive     Boolean  @default(true)
  firstName    String?
  lastName     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships ShopMember[]
  sessions    AuthSession[]

  @@map("users")
}

model AuthSession {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}

model Shop {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  displayName String?
  phone       String?
  contactEmail String?
  website     String?
  address     String?
  operatingHours String?
  logoUrl     String?
  bannerUrl   String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members    ShopMember[]
  categories Category[]
  products   Product[]

  @@map("shops")
}

model ShopMember {
  id        String   @id @default(uuid())
  userId    String
  shopId    String
  role      ShopRole
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([userId, shopId])
  @@index([shopId])
  @@map("shop_members")
}

model Category {
  id        String   @id @default(uuid())
  shopId    String
  name      String
  description String?
  slug      String
  sortOrder Int      @default(0)
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop     Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([shopId, slug])
  // Supports the additional SQL product/category tenant foreign key.
  @@unique([id, shopId])
  @@index([shopId])
  @@map("categories")
}

model Product {
  id          String        @id @default(uuid())
  shopId      String
  categoryId  String?
  name        String
  slug        String
  description String?
  price       Decimal       @db.Decimal(10, 2)
  imageUrl    String?
  status      ProductStatus @default(AVAILABLE)
  isFeatured  Boolean       @default(false)
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  shop     Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@unique([shopId, slug])
  @@index([shopId])
  @@index([categoryId])
  @@map("products")
}
