generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ShopRole {
  OWNER
  ADMIN
  MANAGER
  CASHIER
  KITCHEN
}

enum ProductStatus {
  AVAILABLE
  SOLD_OUT
  HIDDEN
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  isActive     Boolean  @default(true)
  firstName    String?
  lastName     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships ShopMember[]
  sessions    AuthSession[]

  @@map("users")
}

model AuthSession {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}

model Shop {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  displayName String?
  phone       String?
  contactEmail String?
  website     String?
  address     String?
  operatingHours String?
  logoUrl     String?
  bannerUrl   String?
  primaryColor String? @db.VarChar(7)
  accentColor String? @db.VarChar(7)
  menuLayout MenuLayout @default(list)
  isActive    Boolean  @default(true)
  acceptingOrders Boolean @default(true)
  lastOrderNumber BigInt @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members    ShopMember[]
  categories Category[]
  products   Product[]
  addOns     AddOn[]
  tables     RestaurantTable[]
  orders     Order[]

  @@map("shops")
}

model RestaurantTable {
  id        String   @id @default(uuid())
  shopId    String
  number    String   @db.VarChar(40)
  code      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  orders Order[]

  @@unique([id, shopId])
  @@unique([shopId, number])
  @@unique([shopId, code])
  @@map("restaurant_tables")
}

enum OrderMode {
  DINE_IN
  TAKEOUT
}

model Order {
  id          String    @id @default(uuid())
  shopId      String
  tableId     String?
  requestId   String
  requestHash String
  mode        OrderMode @default(DINE_IN)
  status      String    @default("PENDING")
  paymentStatus String @default("UNPAID")
  orderNumber String @db.VarChar(32)
  qrTokenNonce String
  qrTokenExpiresAt DateTime
  qrTokenRevokedAt DateTime?
  tableCode   String?
  tableNumber String?   @db.VarChar(40)
  currency    String    @default("PHP")
  totalPrice  Decimal   @db.Decimal(12, 2)
  items       Json
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  shop        Shop      @relation(fields: [shopId], references: [id], onDelete: Restrict)
  table       RestaurantTable? @relation(fields: [tableId, shopId], references: [id, shopId], onDelete: Restrict, onUpdate: Restrict)
  orderItems OrderItem[]

  @@unique([id, shopId])
  @@unique([shopId, requestId])
  @@unique([shopId, orderNumber])
  @@index([shopId, tableId, createdAt])
  @@map("orders")
}

model OrderItem {
  id String @id @default(uuid())
  shopId String
  orderId String
  productId String?
  lineNumber Int
  quantity Int
  notes String? @db.VarChar(300)
  snapshot Json
  productSnapshotId String
  productNameSnapshot String
  currency String @default("PHP")
  basePriceSnapshot Decimal @db.Decimal(10, 2)
  unitPriceSnapshot Decimal @db.Decimal(12, 2)
  lineTotalSnapshot Decimal @db.Decimal(12, 2)
  variantsSnapshot Json
  addOnsSnapshot Json
  createdAt DateTime @default(now())
  order Order @relation(fields: [orderId, shopId], references: [id, shopId], onDelete: Cascade, onUpdate: Restrict)
  // SQL preserves shopId when product deletion sets only productId to null.
  product Product? @relation(fields: [productId, shopId], references: [id, shopId], onDelete: NoAction, onUpdate: Restrict)

  @@unique([orderId, lineNumber])
  @@index([shopId, orderId])
  @@map("order_items")
}

model ShopMember {
  id        String   @id @default(uuid())
  userId    String
  shopId    String
  role      ShopRole
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([userId, shopId])
  @@index([shopId])
  @@map("shop_members")
}

model Category {
  id        String   @id @default(uuid())
  shopId    String
  name      String
  description String?
  slug      String
  sortOrder Int      @default(0)
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop     Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([shopId, slug])
  // Supports the additional SQL product/category tenant foreign key.
  @@unique([id, shopId])
  @@index([shopId])
  @@map("categories")
}

model Product {
  id          String        @id @default(uuid())
  shopId      String
  categoryId  String?
  name        String
  slug        String
  description String?
  price       Decimal       @db.Decimal(10, 2)
  imageUrl    String?
  status      ProductStatus @default(AVAILABLE)
  isFeatured  Boolean       @default(false)
  isArchived  Boolean       @default(false)
  sortOrder   Int           @default(0)
  featuredSortOrder Int     @default(2147483647)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  shop         Shop                 @relation(fields: [shopId], references: [id], onDelete: Cascade)
  category     Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  optionGroups ProductOptionGroup[]
  variants     ProductVariant[]
  addOns       ProductAddOn[]
  orderItems OrderItem[]

  @@unique([shopId, slug])
  @@unique([id, shopId])
  @@index([shopId])
  @@index([categoryId])
  @@map("products")
}

model ProductOptionGroup {
  id          String           @id @default(uuid())
  shopId      String
  productId   String
  name        String
  isRequired  Boolean          @default(true)
  isAvailable Boolean          @default(true)
  sortOrder   Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  product     Product          @relation(fields: [productId, shopId], references: [id, shopId], onDelete: Cascade, onUpdate: Restrict)
  variants    ProductVariant[]

  @@unique([id, shopId])
  @@unique([id, productId, shopId])
  @@unique([productId, name])
  @@index([shopId, productId])
  @@map("product_option_groups")
}

model ProductVariant {
  // SQL maintains the zero-price default CHECK and one-default-per-choice index.
  id              String              @id @default(uuid())
  shopId          String
  productId       String
  optionGroupId   String?
  name            String
  priceAdjustment Decimal             @default(0) @db.Decimal(10, 2)
  isDefault       Boolean             @default(false)
  isAvailable     Boolean             @default(true)
  sortOrder       Int                 @default(0)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  product         Product             @relation(fields: [productId, shopId], references: [id, shopId], onDelete: Cascade, onUpdate: Restrict)
  optionGroup     ProductOptionGroup? @relation(fields: [optionGroupId, productId, shopId], references: [id, productId, shopId], onDelete: NoAction, onUpdate: Restrict)

  @@unique([id, shopId])
  @@index([shopId, productId, optionGroupId])
  @@map("product_variants")
}

model AddOn {
  // Preserve the SQL-maintained nonnegative, name and sort-order CHECKs.
  id              String         @id @default(uuid())
  shopId          String
  name            String
  priceAdjustment Decimal        @default(0) @db.Decimal(10, 2)
  isAvailable     Boolean        @default(true)
  sortOrder       Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  shop            Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  products        ProductAddOn[]

  @@unique([id, shopId])
  @@unique([shopId, name])
  @@index([shopId])
  @@map("add_ons")
}

model ProductAddOn {
  shopId    String
  productId String
  addOnId   String
  product   Product @relation(fields: [productId, shopId], references: [id, shopId], onDelete: Cascade, onUpdate: Restrict)
  addOn     AddOn   @relation(fields: [addOnId, shopId], references: [id, shopId], onDelete: Cascade, onUpdate: Restrict)

  @@id([productId, addOnId])
  @@index([shopId, productId])
  @@index([addOnId, shopId])
  @@map("product_add_ons")
}
enum MenuLayout {
  grid
  list
  compact
}
