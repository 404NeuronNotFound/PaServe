{
  "name": "api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @paserve/contracts build && nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "pnpm --filter @paserve/contracts build && nest start",
    "start:dev": "pnpm --filter @paserve/contracts build && nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint --type-aware src/ test/",
    "test": "pnpm --filter @paserve/contracts build && vitest run",
    "test:watch": "vitest",
    "test:hash-capacity": "node test/password-capacity.benchmark.mjs",
    "test:hash-login-flood": "node --test test/password-login-flood.metrics.test.mjs && node test/password-login-flood.mjs",
    "test:timeouts:postgres": "node test/request-timeouts.local-postgres.mjs",
    "test:idempotency:postgres": "node test/request-timeouts.local-postgres.mjs idempotency",
    "test:pooling:postgres": "node test/request-timeouts.local-postgres.mjs pooling",
    "test:indexing:postgres": "node test/request-timeouts.local-postgres.mjs indexing",
    "test:tenant-performance:postgres": "node test/request-timeouts.local-postgres.mjs tenants",
    "test:caching:postgres": "node test/request-timeouts.local-postgres.mjs caching",
    "test:load-env": "pnpm build && node test/request-timeouts.local-postgres.mjs load",
    "test:load-env:search": "pnpm build && node test/request-timeouts.local-postgres.mjs load-search",
    "test:load-ramp": "pnpm build && node test/request-timeouts.local-postgres.mjs load-ramp",
    "test:login-flood": "pnpm build && node test/request-timeouts.local-postgres.mjs load-login-flood",
    "test:menu-spike": "pnpm build && node test/request-timeouts.local-postgres.mjs load-menu-spike",
    "test:order-burst": "pnpm build && node test/request-timeouts.local-postgres.mjs load-order-burst",
    "test:load-ramp:diagnostic": "pnpm build && node test/request-timeouts.local-postgres.mjs load-ramp-diagnostic",
    "test:timeouts:supabase": "vitest run --config vitest.config.e2e.ts test/supabase-latency.e2e-spec.ts",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "pnpm --filter @paserve/contracts build && vitest run --config ./vitest.config.e2e.ts",
    "test:realtime": "vitest run --config ./vitest.config.realtime.ts",
    "postinstall": "prisma skills sync || exit 0",
    "seed:build": "pnpm --filter @paserve/contracts build && tsc -p tsconfig.seed.json",
    "seed": "pnpm seed:build && node .seed-build/prisma/seed.js",
    "seed:dry-run": "pnpm seed --dry-run",
    "seed:reset": "pnpm seed --reset-demo",
    "seed:verify": "pnpm seed --verify",
    "seed:images": "pnpm seed --upload-images",
    "test:realtime-fanout": "pnpm build && node --test test/realtime-fanout.identity.test.mjs && node test/realtime-fanout.mjs local",
    "test:realtime-fanout:hosted": "pnpm build && node --test test/realtime-fanout.identity.test.mjs && node test/realtime-fanout.mjs hosted"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/throttler": "^6.7.1",
    "@paserve/contracts": "workspace:*",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "@supabase/supabase-js": "^2.117.2",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.6",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.12",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "prisma": "7.10.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.12"
  }
}
