PORT=3000
# Colocated edge: set 127.0.0.1. Containers may require 0.0.0.0 on a PRIVATE network.
# API_BIND_ADDRESS=127.0.0.1
DATABASE_URL=
# Optional Prisma CLI/migration connection; runtime NEVER reads this URL.
# Use the project's direct or supported session-mode administrative connection.
DIRECT_DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
FRONTEND_ORIGINS=http://localhost:5173
# Deployment: set NODE_ENV=production and replace FRONTEND_ORIGINS with explicit
# HTTPS origins (no paths/wildcards/loopback). This is also the cookie-auth allowlist.
# Never expose JWT/database/service-role secrets through VITE_ variables.

# Leave blank for direct connections. Use only the actual proxy IPs/CIDRs, never all networks.
TRUSTED_PROXY_CIDRS=

# Per-process API admission. Saturation returns 503 with Retry-After: 1; no queue.
# Each sub-budget must be smaller than API_MAX_IN_FLIGHT. Tune on the chosen host.
# API_MAX_IN_FLIGHT=128
# API_MAX_IN_FLIGHT_PER_IP=16
# API_MAX_AUTH_IN_FLIGHT=32
# API_MAX_STREAMS=32
# API_MAX_EXPENSIVE_IN_FLIGHT=16
# Per-process fairness after route guards. Public menu and verified staff shop
# budgets are separate; IP/global limits still run before authentication.
# In-flight values cannot exceed max(1, floor(API_MAX_IN_FLIGHT / 4)).
# API_FAIR_TENANT_IN_FLIGHT=32
# API_FAIR_ACCOUNT_IN_FLIGHT=8
# Token buckets: initial burst plus continuous refill at the per-minute rate.
# API_FAIR_TENANT_BURST=300
# API_FAIR_TENANT_PER_MINUTE=1200
# API_FAIR_ACCOUNT_BURST=60
# API_FAIR_ACCOUNT_PER_MINUTE=600
# Bounded active/idle scope state; new scopes receive 503 when full.
# API_FAIR_MAX_SCOPES=4096
# Within the total, reserve 16 staff slots and one fixed readiness slot.
# Ordinary requests use at most 111 slots globally and 14 per IP by default.
# API_RESERVED_CRITICAL=16
# API_RESERVED_CRITICAL_PER_IP=2
# Finite public catalog GETs reserve part of ordinary capacity (not staff/health).
# Defaults shrink to zero for tiny capacities; zero explicitly disables a reserve.
# API_RESERVED_MENU_READS=8
# API_RESERVED_MENU_READS_PER_IP=1
# Minimum total is 3 and minimum per-IP total is 2; reserves must leave ordinary room.

# Matched-route response deadlines in milliseconds (100..120000).
# API_READ_TIMEOUT_MS=15000
# API_WRITE_TIMEOUT_MS=45000
# API_AUTH_TIMEOUT_MS=10000
# API_REPORT_TIMEOUT_MS=30000
# API_UPLOAD_TIMEOUT_MS=30000
# API_STREAM_SETUP_TIMEOUT_MS=10000
# API_HEALTH_TIMEOUT_MS=3000
# HTTP transport: headers 10s, body reception 30s, socket inactivity 60s, keepalive 5s.
# Changing response deadlines above 60s also requires reviewing transport/edge caps.

# PostgreSQL per-connection deadlines (100..60000); lock must be below statement.
# DB_CONNECTION_TIMEOUT_MS=3000
# DB_STATEMENT_TIMEOUT_MS=10000
# DB_LOCK_TIMEOUT_MS=3000
# DB_IDLE_TRANSACTION_TIMEOUT_MS=15000
# DB_TRANSACTION_MAX_WAIT_MS=3000
# DB_TRANSACTION_TIMEOUT_MS=30000
# Explicit transaction options in existing workflows take precedence over defaults.
# Verify effective settings on the selected database/proxy; no global role changes.

# One lazy pool per singleton API PrismaService (not per request/shop/user).
# DB_POOL_MAX=5
# DB_POOL_MAX_WAITING=20
# DB_POOL_IDLE_TIMEOUT_MS=10000
# DB_POOL_MAX_LIFETIME_SECONDS=300
# Set BOTH optional budget declarations from the actual deployment allocation.
# Include API workers, replicas and rolling-deployment overlap in max processes.
# DB_POOL_MAX_PROCESSES=
# DB_POOL_CONNECTION_BUDGET=
# DB_POOL_MAX * DB_POOL_MAX_PROCESSES must fit the allocated application budget.
# This validates a declared budget; it does not enforce the hosting autoscale cap.
# For hosted runtime pooling, copy the exact Supabase Dashboard pooler URI into
# DATABASE_URL. Do not guess the pooler host/username or use frontend VITE_ vars.

# Native Argon2 work, independent of HTTP admission. Defaults: 2 jobs, 128 MiB.
# AUTH_HASH_MAX_CONCURRENT=2
# AUTH_HASH_MEMORY_MB=128
# If tuning UV_THREADPOOL_SIZE, set it in the process launcher BEFORE Node starts,
# not here; leave at least one pool slot beyond AUTH_HASH_MAX_CONCURRENT.

# Progressive authentication challenges default on in production, off otherwise.
# Set true locally only with a configured widget. Never expose its secret in VITE_.
# AUTH_BOT_CHALLENGE_ENABLED=true
TURNSTILE_SECRET_KEY=
# Explicit widget hostnames, comma-separated, with no scheme/path/port/wildcard.
TURNSTILE_HOSTNAMES=

# Public pickup catalog cache. Apply public_menu_cache_versions migration first.
# Every hit still checks live shop visibility and the database catalog version.
PUBLIC_MENU_CACHE_ENABLED=true
PUBLIC_MENU_CACHE_TTL_MS=15000
PUBLIC_MENU_CACHE_MAX_ENTRIES=128
PUBLIC_MENU_CACHE_MAX_BYTES=8388608
PUBLIC_MENU_CACHE_MAX_ENTRY_BYTES=524288
PUBLIC_MENU_CACHE_MAX_IN_FLIGHT=16

# Demo seed writes require all three; enable only for a confirmed development target.
# NODE_ENV=development
# ALLOW_DEMO_SEED=true
# DEMO_DATABASE_TARGET=localhost/paserve
# DEMO_SEED_RANDOM=20261022
# DEMO_SEED_NOW=2026-10-22T15:00:00+08:00
