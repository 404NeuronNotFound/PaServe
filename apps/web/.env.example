# Release builds require a real HTTPS endpoint or a configured same-origin API path.
# Use build:local for loopback endpoints; never deploy that output.
VITE_API_URL=
# Optional customer website origin, e.g. https://menu.example.com (no path).
# Defaults to the browser's current origin. Used for printable table QR links.
VITE_PUBLIC_APP_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Public Turnstile site key matching the server secret and allowed hostnames.
# Required when enabling progressive bot challenges on the API.
VITE_TURNSTILE_SITE_KEY=

# Explicit optional media/connection origins, comma-separated; never wildcards or URL paths.
# Build policies already include self, the API origin and configured Supabase project origin.
VITE_CSP_IMAGE_ORIGINS=
VITE_CSP_CONNECT_ORIGINS=
# Optional rollout mode: no enforced meta CSP is emitted while true. Default false/enforced.
CSP_REPORT_ONLY=false
