# Generated by scripts/edge-config.mjs. Standalone API edge, not a frontend host.
worker_processes @@WORKERS@@;
@@WORKER_USER@@
pid "@@PREFIX@@/logs/nginx.pid";
error_log "@@PREFIX@@/logs/error.log" crit;
events { worker_connections 4096; }
http {
    map_hash_bucket_size 512;
    server_tokens off;
    default_type application/json;
    merge_slashes on;
    client_header_timeout 10s;
    client_body_timeout 10s;
    send_timeout 15s;
    keepalive_timeout 15s;
    client_header_buffer_size 1k;
    large_client_header_buffers 4 8k;
    client_body_temp_path "@@PREFIX@@/body";
    proxy_temp_path "@@PREFIX@@/proxy";

    # Never trust client-supplied forwarding headers. A future CDN needs an
    # explicitly reviewed real_ip configuration and origin network restrictions.
    map $http_host $paserve_host_allowed {
        default 0;
        "@@HOST@@" 1;
        "@@HOST@@:@@PORT@@" 1;
    }
    map $http_origin $paserve_cors_origin {
        default "";
@@CORS_ORIGINS@@
    }
    map $paserve_cors_origin $paserve_cors_credentials { default "true"; "" ""; }
    map $request_method $paserve_method_allowed {
        default 0;
        GET 1; HEAD 1; OPTIONS 1; POST 1; PATCH 1; DELETE 1;
    }
    map $uri $paserve_scanner_path {
        default 0;
        ~*(^|/)[.](env|git|svn|hg)([./-]|$) 1;
        ~*^/(api/v1/)?(wp-admin|wp-login[.]php|xmlrpc[.]php|phpmyadmin|vendor/phpunit)(/|$) 1;
        # Residual percent encoding after NGINX normalization is not a PaServe
        # route. Query values are excluded: searches/notes may contain percent signs.
        ~[%] 1;
    }
    map $uri $paserve_route_class {
        default api;
        ~*^/api/v1/auth/(login|register|refresh)/?$ auth;
        ~*^/api/v1/shops/[^/]+/(logo|banner|products/[^/]+/image)/?$ upload;
        ~*^/api/v1/(menu|shops)/.+/([a-z-]*events)/?$ stream;
    }
    map "$request_method:$uri" $paserve_bad_route_method {
        default 0;
        ~*^(GET|HEAD|PATCH|DELETE):/api/v1/auth/(login|register|refresh|logout|email|password)/?$ 1;
        ~*^(POST|PATCH|DELETE|HEAD):/api/v1/(menu|shops)/.+/([a-z-]*events)/?$ 1;
    }
    map "$http_content_length:$http_transfer_encoding" $paserve_empty_body {
        default 0;
        ~^0?:$ 1;
    }
    map "$paserve_route_class:$request_method:$http_content_type:$paserve_empty_body" $paserve_type_allowed {
        default 0;
        ~^[^:]+:(GET|HEAD|OPTIONS): 1;
        ~^[^:]+:(POST|PATCH|DELETE)::1$ 1;
        "~*^(api|auth):(POST|PATCH|DELETE):application/json([;].*)?:[01]$" 1;
        "~*^upload:(PATCH|DELETE):application/json([;].*)?:[01]$" 1;
        "~*^upload:POST:multipart/form-data[;].+:[01]$" 1;
    }
    # Empty keys are not counted. OPTIONS still has the general API budget.
    map $uri $paserve_api_key { default ""; ~*^/api/v1(/|$) $binary_remote_addr; }
    map "$request_method:$uri" $paserve_login_key { default ""; ~*^POST:/api/v1/auth/login/?$ $binary_remote_addr; }
    map "$request_method:$uri" $paserve_register_key { default ""; ~*^POST:/api/v1/auth/register/?$ $binary_remote_addr; }
    map "$request_method:$uri" $paserve_refresh_key { default ""; ~*^POST:/api/v1/auth/refresh/?$ $binary_remote_addr; }
    map "$request_method:$paserve_route_class" $paserve_auth_ip { default ""; POST:auth $binary_remote_addr; }
    map $paserve_auth_ip $paserve_auth_total { default auth; "" ""; }
    map "$request_method:$paserve_route_class" $paserve_upload_ip { default ""; POST:upload $binary_remote_addr; }
    map $paserve_upload_ip $paserve_upload_total { default upload; "" ""; }
    limit_req_zone $paserve_api_key zone=paserve_api:10m rate=50r/s;
    limit_req_zone $paserve_login_key zone=paserve_login:10m rate=12r/m;
    limit_req_zone $paserve_register_key zone=paserve_register:10m rate=6r/m;
    limit_req_zone $paserve_refresh_key zone=paserve_refresh:10m rate=40r/m;
    limit_req_zone $paserve_auth_total zone=paserve_auth_rate:1m rate=120r/m;
    limit_req_zone $paserve_upload_ip zone=paserve_upload_rate:10m rate=40r/m;
    limit_conn_zone $binary_remote_addr zone=paserve_connections:10m;
    limit_conn_zone $paserve_auth_ip zone=paserve_auth_connections:10m;
    limit_conn_zone $paserve_auth_total zone=paserve_auth_total:1m;
    limit_conn_zone $paserve_upload_ip zone=paserve_upload_connections:10m;
    limit_conn_zone $paserve_upload_total zone=paserve_upload_total:1m;

    # No URI, query, IP, body, token, cookie, email or user-agent in access logs.
    # About 1/256 requests are sampled. Rotation/quota is still required on host.
    map $request_id $paserve_log_sample { default 0; ~^00 1; }
    log_format paserve_edge escape=json '{"time":"$time_iso8601","id":"$request_id","class":"$paserve_route_class","status":$status,"upstream":"$upstream_status","seconds":"$request_time","bytes":$bytes_sent,"limit":"$limit_req_status"}';
    access_log "@@PREFIX@@/logs/access.log" paserve_edge buffer=32k flush=1s if=$paserve_log_sample;

    upstream paserve_origin { least_conn; @@UPSTREAM_SERVERS@@ keepalive 16; }
    # One auth owner until risk, replay and account budgets have a shared store.
    upstream paserve_auth_origin { server @@AUTH_UPSTREAM@@; keepalive 8; }
    server {
        listen @@LISTEN@@ default_server@@SSL_LISTEN@@;
        server_name @@HOST@@;
@@TLS@@
        if ($paserve_host_allowed = 0) { return 421; }
        if ($paserve_scanner_path = 1) { return 403; }
        if ($paserve_method_allowed = 0) { return 405; }
        if ($paserve_bad_route_method = 1) { return 405; }
        if ($paserve_type_allowed = 0) { return 415; }

        limit_req_status 429;
        limit_conn_status 429;
        limit_req zone=paserve_api burst=100 nodelay;
        limit_req zone=paserve_login burst=10 nodelay;
        limit_req zone=paserve_register burst=5 nodelay;
        limit_req zone=paserve_refresh burst=20 nodelay;
        limit_req zone=paserve_auth_rate burst=20 nodelay;
        limit_req zone=paserve_upload_rate burst=10 nodelay;
        limit_conn paserve_connections 200;
        client_max_body_size 1m;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header Forwarded "";
        proxy_set_header CF-Connecting-IP "";
        proxy_set_header True-Client-IP "";
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header X-Original-URL "";
        proxy_set_header X-Rewrite-URL "";
        proxy_set_header Proxy "";
        proxy_set_header Connection "";
        proxy_set_header Upgrade "";
        proxy_hide_header X-Powered-By;
        proxy_connect_timeout 3s;
        proxy_send_timeout 15s;
        proxy_read_timeout 75s;
        proxy_next_upstream off;
        proxy_intercept_errors off;
        proxy_cache off;
        # Buffer the entire bounded body before opening upstream processing.
        proxy_request_buffering on;
        # Keep SSE heartbeat delivery immediate; never cache receipt/session data.
        proxy_buffering off;
@@SERVER_HEADERS@@
@@ERRORS@@

        location ~* ^/api/v1/auth/(login|register|refresh)/?$ {
            client_max_body_size 16k;
            # Defining a location limit_conn disables inherited declarations.
            limit_conn paserve_connections 200;
            limit_conn paserve_auth_connections 4;
            limit_conn paserve_auth_total 16;
            proxy_pass http://paserve_auth_origin;
        }
        location ~* ^/api/v1/auth(/|$) { proxy_pass http://paserve_auth_origin; }
        location ~* ^/api/v1/shops/[^/]+/(logo|banner|products/[^/]+/image)/?$ {
            client_max_body_size 6m;
            limit_conn paserve_connections 200;
            limit_conn paserve_upload_connections 4;
            limit_conn paserve_upload_total 16;
            proxy_pass http://paserve_origin;
        }
        location ~* ^/api/v1/(menu|shops)/.+/([a-z-]*events)/?$ {
            client_max_body_size 1k;
            proxy_pass http://paserve_origin;
        }
        location ~* ^/api/v1(/|$) { proxy_pass http://paserve_origin; }
        location / { return 404; }
    }
}
