  "main": "index.js",
  "scripts": {
    "lint": "pnpm --filter api lint && pnpm --filter web lint",
    "build": "pnpm --filter api build && pnpm --filter web build",
    "verify": "pnpm --filter api db:generate && pnpm lint && pnpm build && pnpm check:secrets && pnpm audit --audit-level=low",
    "audit:secrets": "python scripts/audit-secrets.py",
    "deployment:vercel": "node scripts/prepare-vercel.mjs",
    "release:check": "node scripts/release-readiness.mjs",
    "edge:render": "node scripts/edge-config.mjs",
    "monitor:database": "pnpm --filter api monitor:database",
    "check:secrets": "node scripts/security-leaks.mjs"
  },
  "keywords": [],
